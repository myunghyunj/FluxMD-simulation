{
  "environment": {
    "python_version": "3.8",
    "gpu": true,
    "additional_allowed_domains": [
      "download.pytorch.org",
      "nvidia.com"
    ]
  },
  "setup": [
    "pip install --upgrade pip",
    "pip install torch==2.3.0+cu121 torchvision==0.18.0+cu121 --index-url https://download.pytorch.org/whl/cu121",
    "pip install -e '.[dev,gpu]'"
  ],
  "run": "pytest -q tests/"
}
